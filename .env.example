# Local-only, process-private storage. Do not use in production.
APP_ENV=development
STORAGE=memory
DEMO_SEED=false
WORKER_ID=worker-1
MAX_CONCURRENCY=10
LEASE_TTL=30s
REAPER_INTERVAL=10s
JOB_TIMEOUT=5m
PORT=50051
GRPC_HOST=127.0.0.1
METRICS_ADDR=127.0.0.1:9090

# Local Docker development uses APP_ENV=development.
# Production requires STORAGE=postgres, credentials, TLS, and a worker token:
# APP_ENV=production
# STORAGE=postgres
# DATABASE_URL=postgres://scheduler:<password>@db.example/scheduler?sslmode=verify-full
# For `make migrate`, append options=-c%20lock_timeout%3D5s so index builds
# fail fast instead of queueing an ACCESS lock behind production traffic
# (the CONCURRENTLY migration files require it; make migrate injects it).
# RABBITMQ_URL=amqps://scheduler:<password>@queue.example:5671/
# TLS_CERT_FILE=/run/secrets/server.crt
# TLS_KEY_FILE=/run/secrets/server.key
# WORKER_TOKEN=<at-least-32-random-characters>
# ADMIN_TOKEN=<optional-distinct-at-least-32-random-characters>
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example:4317
